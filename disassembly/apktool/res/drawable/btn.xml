            <corners android:radius="1.0dip" />
            <solid android:color="@color/orplayer_focuse_item_color" />
            <stroke android:width="0.70000005dip" android:color="#bc131313" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="1.0dip" />
            <solid android:color="#99000000" />
            <stroke android:width="0.70000005dip" android:color="#ffffffff" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="1.0dip" />
            <solid android:color="#99000000" />
            <stroke android:width="0.30000007dip" android:color="#6f797d7e" />
        </shape>
    </item>
